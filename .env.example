# 复制为 .env 并填入真实值；真实凭据永远不要提交进仓库
# cp .env.example .env

# ---- 邮件发送（腾讯企业邮箱 / 其他 SMTP 供应商均可，以你的供应商为准）----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-client-secret
# 交付核验用的 IMAP 主机
IMAP_HOST=imap.exmail.qq.com

# ---- 收件人与邮件文案 ----
RECIPIENT_EMAIL=ops@example.com
EMAIL_GREETING=您好

# ---- 渠道后台（浏览器采集目标，由 Agent 会话访问）----
CHANNEL_REPORT_URL=https://your-channel-backend.example.com

# ---- 可选：本地工作目录与 Node 路径（看板 PNG 渲染用）----
# WORKSPACE_DIR=./output
# NODE_BIN=/usr/local/bin/node
